rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usernames/prabath9052).data.authUid == request.auth.uid;
    }
    function isBot() { return request.auth != null && request.auth.uid == '6EG61Ugx0vb2G3AOVFPsh0XUZoh1'; }

    // ---- usernames: KEEP THE BLOCK YOU HAVE PUBLISHED TODAY ----
    // (Its exact text is only in the Firebase console. If yours differs from this one, keep yours.)
    // This version matches what the app does: public lookup of ID -> email at sign-in,
    // a signed-in user can create their own ID doc once, nobody edits or deletes it.
    match /usernames/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Push subscriptions: each user writes only their own doc; the sender bot can read and prune; admin can read (device count).
    match /pushSubs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isBot() || isAdmin());
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if isBot() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subs','pruned']);
    }
    // Nominations: only the admin writes; the user can read their own; bot reads all.
    match /alertNominees/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isBot() || isAdmin());
      allow write: if isAdmin();
    }

    // NEW: private station data + alert history/state (docs: station, stationSeries, alertsLog, windState, humidityState).
    // Any signed-in user can read; only the bot (GitHub Action) writes.
    match /private/{doc} {
      allow read: if request.auth != null;
      allow write: if isBot();
    }
  }
}
