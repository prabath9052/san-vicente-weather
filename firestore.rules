rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A-02 (2026-10-28): admin = fixed uid of prabath9052; no longer depends on the usernames doc.
    function isAdmin() { return request.auth != null && request.auth.uid == '41BiaByGybbl0GX2pZdwc9EjDIo2'; }
    function isBot() { return request.auth != null && request.auth.uid == '6EG61Ugx0vb2G3AOVFPsh0XUZoh1'; }

    // usernames: ID -> email lookup for login. A-01 (2026-10-26): single-doc get by exact ID stays public
    // (login before sign-in needs it); listing/bulk read is limited to the admin, or a signed-in user's own doc.
    match /usernames/{id} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.authUid == request.auth.uid && (id != 'prabath9052' || isAdmin());
      allow update, delete: if request.auth != null && resource.data.authUid == request.auth.uid && (id != 'prabath9052' || isAdmin());
    }

    // Push subscriptions: each user writes only their own doc; the sender bot can read and prune; admin can read (device count).
    match /pushSubs/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isBot() || isAdmin());
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow update: if isBot() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subs','pruned']);
    }
    // Nominations: only the admin writes; the user can read their own; bot reads all.
    match /alertNominees/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isBot() || isAdmin());
      allow write: if isAdmin();
    }

    // NEW: private station data + alert history/state (docs: station, stationSeries, alertsLog, windState, humidityState).
    // Any signed-in user can read; only the bot (GitHub Action) writes.
    match /private/{doc} {
      allow read: if request.auth != null;
      allow write: if isBot();
    }
  }
}
